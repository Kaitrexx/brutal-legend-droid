{
  "id": "windows-box64",
  "label": "Windows 64-bit + Wine + Box64 + Vortek",
  "game_build": "windows-x86_64",
  "command": "{RUNTIME_DIR}/bin/run-windows.sh \"{GAME_DIR}\" \"{LOG_FILE}\" \"{FPS_LOG}\"",
  "env": {
    "BOX64_DYNAREC": "1",
    "BOX64_DYNAREC_BIGBLOCK": "3",
    "BOX64_DYNAREC_STRONGMEM": "1",
    "BOX64_DYNAREC_FASTNAN": "1",
    "BOX64_DYNAREC_FORWARD": "1024",
    "DXVK_ASYNC": "1",
    "DXVK_HUD": "fps"
  },
  "notes": "Winlator 11.2.0 komponentleri esasinda. Mali uchun Vortek + DXVK 1.10.3 async. 4 GB RAM ucun en agir yol."
}
